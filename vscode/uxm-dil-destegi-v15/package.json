{
  "name": "uxm-dil-destegi-v15",
  "displayName": "UXM Dil Desteği / UXM Language Support",
  "description": "UXM icin tek sayfa kontrol merkezi, trace izleme ve not yonetimi.",
  "version": "0.16.0",
  "publisher": "mete",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "uxm",
        "aliases": [
          "UXM",
          "uXBasic Mini"
        ],
        "extensions": [
          ".uxm"
        ]
      }
    ],
    "grammars": [
      {
        "language": "uxm",
        "scopeName": "source.uxm",
        "path": "./syntaxes/uxm.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "uxm",
        "path": "./snippets/uxm.json"
      }
    ],
    "commands": [
      {
        "command": "uxm.controlCenter",
        "title": "UXM: Kontrol Merkezi"
      },
      {
        "command": "uxm.openControlPanel",
        "title": "UXM: Kontrol Merkezi (Uyumluluk)"
      },
      {
        "command": "uxm.compile",
        "title": "UXM: Compile"
      },
      {
        "command": "uxm.runTests",
        "title": "UXM: Run Tests"
      },
      {
        "command": "uxm.bellekTest",
        "title": "UXM: Bellek Test"
      },
      {
        "command": "uxm.hizliTara",
        "title": "UXM: Hızlı Tara"
      },
      {
        "command": "uxm.hataliTest",
        "title": "UXM: Hatalı Test"
      },
      {
        "command": "uxm.tumTest",
        "title": "UXM: Tüm Test"
      },
      {
        "command": "uxm.derleyiciDerle",
        "title": "UXM: Derleyiciyi Derle"
      },
      {
        "command": "uxm.alanTopla",
        "title": "UXM: Alan Topla"
      },
      {
        "command": "uxm.raporGoster",
        "title": "UXM: Rapor Göster"
      },
      {
        "command": "uxm.stage17",
        "title": "UXM: Stage-17 Kontrol"
      },
      {
        "command": "uxm.stage18",
        "title": "UXM: Stage-18 Rapor"
      },
      {
        "command": "uxm.stage19",
        "title": "UXM: Stage-19 Temizlik"
      },
      {
        "command": "uxm.stage20",
        "title": "UXM: Stage-20 Release"
      }
    ]
  }
}