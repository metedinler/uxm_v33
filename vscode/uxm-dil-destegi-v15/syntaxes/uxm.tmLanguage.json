{
  "scopeName": "source.uxm",
  "patterns": [
    {
      "match": "(?i)^%%(if|else|endif|include|platform|destos|nozerovars|secstack|endcomp|errorendcomp)\\b.*$",
      "name": "keyword.directive.preproc.uxm"
    },
    {
      "match": "(?i)^include\\b.*$",
      "name": "keyword.directive.include.uxm"
    },
    {
      "match": "(?i)^#(mode|cell|bounds|overflow|compare|endian|memory|seed|arge|poly|expr-rpn|matrix|identity|zeros|ones)\\b.*$",
      "name": "keyword.directive.uxm"
    },
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.uxm"
    },
    {
      "match": "\\(\\*T\\)|\\(\\*\\(T[+-][0-9]+\\)\\)",
      "name": "constant.other.addressing.uxm"
    },
    {
      "match": "\\([TSDPFE][^\\)]*\\)",
      "name": "constant.other.addressing.uxm"
    },
    {
      "match": "@!?#\\d+|@@\\d+|@\\*",
      "name": "invalid.illegal.meta.uxm"
    },
    {
      "match": "@!?#|@!?\\([^\\)]+\\)|@!?\\d+",
      "name": "entity.name.function.service.uxm"
    },
    {
      "match": ":\\w[\\w\\-]*",
      "name": "entity.name.label.uxm"
    },
    {
      "match": "\\bp\\d+\\b",
      "name": "variable.other.stringref.uxm"
    },
    {
      "match": "\\bs\\d+\\b",
      "name": "variable.other.stringdef.uxm"
    },
    {
      "match": "\\bm\\d+\\b",
      "name": "variable.other.macro.uxm"
    },
    {
      "match": "(?<!\\w)[><+\\-]k\\d+\\b",
      "name": "keyword.operator.repeat.uxm"
    },
    {
      "match": "[><+\\-0\\.,\\[\\]\\$%\\?;!&\\|\\^~\\{\\}eE]",
      "name": "keyword.operator.uxm"
    },
    {
      "match": "\\b(memory|cell|mode|total|tape|stack|data|fifo|queue|byte|kb|mb|dword|normal)\\b",
      "name": "keyword.control.uxm"
    },
    {
      "match": "\\bk\\d+\\b",
      "name": "constant.numeric.repeat.uxm"
    }
  ]
}