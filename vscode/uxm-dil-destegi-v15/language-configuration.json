{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "{",
      "}"
    ]
  ],
  "wordPattern": "(@!?#|@!?\\([^\\)]+\\)|@!?[0-9]+|[spm][0-9]+|\\(\\*\\(T[+-][0-9]+\\)\\)|\\(\\*T\\)|\\([TDSPFE][^\\)]*\\)|[A-Za-z_][A-Za-z0-9_]*)"
}